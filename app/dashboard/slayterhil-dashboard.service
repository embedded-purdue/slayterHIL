[Unit]
Description=SlayterHIL test dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=flight_sim
WorkingDirectory=/home/flight_sim/slayterHIL/app/dashboard
# Loopback only; `tailscale serve` publishes it to the tailnet over HTTPS.
Environment=DASHBOARD_HOST=127.0.0.1
Environment=DASHBOARD_PORT=8080
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/flight_sim/slayterHIL/.venv/bin/python server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
